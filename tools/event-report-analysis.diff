diff --git a/backend/app/services/event_breakdown.py b/backend/app/services/event_breakdown.py
new file mode 100644
index 0000000..0e94eb9
--- /dev/null
+++ b/backend/app/services/event_breakdown.py
@@ -0,0 +1,19 @@
+"""Only questions actually opened during the event contribute to the denominator."""
+def breakdown(history, ranking):
+    if not history:
+        return None
+    players = {name: [0, 0, 0] for name, _ in ranking}
+    questions = []
+    def row(label, counts):
+        total = sum(counts)
+        return dict(label=label, counts=counts, total=total,
+                    rates=[value / total if total else None for value in counts])
+    for question in history:
+        counts = [0, 0, 0]
+        for name, answer in question['answers'].items():
+            index = 2 if answer is None else 0 if answer else 1
+            counts[index] += 1
+            if name in players:
+                players[name][index] += 1
+        questions.append(row(question['title'], counts))
+    return dict(players=[row(name, counts) for name, counts in players.items()], questions=questions)
